{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JustMark",
  "version": "0.0.5",
  "identifier": "com.simonchen.justmark",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JustMark",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "devtools": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Capability for the main window",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "core:window:allow-set-title",
            "core:window:allow-center",
            "core:window:allow-set-size",
            "core:window:allow-set-position",
            "dialog:allow-open",
            "dialog:allow-save",
            "fs:default",
            {
              "identifier": "fs:scope",
              "allow": [
                { "path": "**" },
                { "path": "$HOME/**" },
                { "path": "$DOCUMENT/**" },
                { "path": "$DESKTOP/**" },
                { "path": "$DOWNLOAD/**" }
              ]
            },
            "fs:allow-read-text-file",
            "fs:allow-read-dir",
            "fs:allow-write-text-file",
            "fs:allow-write-file",
            "fs:allow-remove",
            "fs:allow-mkdir",
            "fs:allow-exists",
            "fs:allow-read-file",
            "fs:allow-stat",
            "fs:allow-lstat",
            "fs:allow-fstat",
            "shell:allow-execute",
            "shell:allow-open",
            {
              "identifier": "shell:allow-execute",
              "allow": [
                {
                  "name": "git",
                  "cmd": "git",
                  "args": true
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "opener": {},
    "shell": {
      "open": true
    }
  }
}